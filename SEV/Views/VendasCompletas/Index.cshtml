@model IEnumerable<SEV.Models.Venda>

@{
    ViewData["Title"] = "Vendas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">
        <i class="bi bi-cart-check text-primary"></i> Vendas
    </h1>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nova Venda
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-cart-x display-1 text-muted"></i>
                <h4 class="text-muted mt-3">Nenhuma venda encontrada</h4>
                <p class="text-muted">Clique em "Nova Venda" para começar</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Data</th>
                            <th>Cliente</th>
                            <th>Itens</th>
                            <th>Total</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venda in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary">#@venda.VendaId</span>
                                </td>
                                <td>
                                    <i class="bi bi-calendar-event text-muted"></i>
                                    @venda.DataVenda.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-person-circle text-info me-2"></i>
                                        <span class="fw-medium">@(venda.Cliente?.Nome ?? "Cliente não encontrado")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @(venda.Itens?.Count ?? 0) item(s)
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">
                                        R$ @venda.TotalCalculado.ToString("N2")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@venda.VendaId" 
                                           class="btn btn-outline-info" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@venda.VendaId" 
                                           class="btn btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@venda.VendaId" 
                                           class="btn btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Adicionar confirmação para exclusão
        $(document).ready(function() {
            $('a[asp-action="Delete"]').click(function(e) {
                if (!confirm('Tem certeza que deseja excluir esta venda?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
