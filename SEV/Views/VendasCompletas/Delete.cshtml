@model SEV.Models.Venda

@{
    ViewData["Title"] = $"Excluir Venda #{Model.VendaId}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0 text-danger">
        <i class="bi bi-exclamation-triangle"></i> Excluir Venda
    </h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="alert alert-danger">
    <h4 class="alert-heading">
        <i class="bi bi-exclamation-triangle"></i> Atenção!
    </h4>
    <p class="mb-0">
        <strong>Tem certeza que deseja excluir esta venda?</strong><br>
        Esta ação não pode ser desfeita e todos os itens serão devolvidos ao estoque.
    </p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informações da Venda</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-6">
                        <strong>ID:</strong><br>
                        <span class="badge bg-danger">#@Model.VendaId</span>
                    </div>
                    <div class="col-6">
                        <strong>Data:</strong><br>
                        <i class="bi bi-calendar-event text-muted"></i>
                        @Model.DataVenda.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
                
                <div class="mb-3">
                    <strong>Cliente:</strong><br>
                    <div class="d-flex align-items-center mt-1">
                        <i class="bi bi-person-circle text-info me-2"></i>
                        <span class="fw-medium">@(Model.Cliente?.Nome ?? "Cliente não encontrado")</span>
                    </div>
                </div>

                <div class="alert alert-warning">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total da Venda:</span>
                        <span class="h5 mb-0 text-danger">R$ @Model.TotalCalculado.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <span class="text-muted">Itens:</span>
                        <span class="badge bg-secondary">@(Model.Itens?.Count ?? 0)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Itens que serão afetados</h5>
            </div>
            <div class="card-body">
                @if (Model.Itens == null || !Model.Itens.Any())
                {
                    <div class="text-center py-3">
                        <i class="bi bi-cart-x text-muted"></i>
                        <p class="text-muted mt-2">Esta venda não possui itens</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th class="text-center">Quantidade</th>
                                    <th class="text-end">Preço Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Itens)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-box text-primary me-2"></i>
                                                <span class="fw-medium">@(item.Produto?.Nome ?? "Produto não encontrado")</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary">@item.Quantidade</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-medium">R$ @item.PrecoUnitario.ToString("N2")</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-medium">R$ @item.Subtotal.ToString("N2")</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold">Total:</td>
                                    <td class="text-end fw-bold text-danger">
                                        R$ @Model.TotalCalculado.ToString("N2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3">
                        <h6><i class="bi bi-info-circle"></i> Impacto da exclusão:</h6>
                        <ul class="mb-0">
                            <li>A venda será removida permanentemente</li>
                            <li>Todos os itens serão devolvidos ao estoque</li>
                            <li>O histórico de vendas será afetado</li>
                            <li>Esta ação não pode ser desfeita</li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center mt-4">
    <form asp-action="Delete" method="post" class="d-inline">
        <input type="hidden" asp-for="VendaId" />
        <button type="submit" class="btn btn-danger btn-lg me-3">
            <i class="bi bi-trash"></i> Confirmar Exclusão
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
    </form>
</div>

@section Scripts {
    <script>
        // Confirmação adicional antes de excluir
        document.querySelector('form').addEventListener('submit', function(e) {
            if (!confirm('ATENÇÃO: Esta ação não pode ser desfeita!\n\nTem certeza que deseja excluir esta venda?')) {
                e.preventDefault();
            }
        });
    </script>
}
