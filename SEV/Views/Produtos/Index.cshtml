@model IEnumerable<SEV.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="container-fluid">
    <!-- Header da Página -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="text-gradient mb-2">
                        <i class="bi bi-box-seam me-3"></i>Produtos
                    </h1>
                    <p class="text-muted mb-0">Gerencie seu catálogo de produtos e estoque</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" onclick="exportarProdutos()">
                        <i class="bi bi-download me-2"></i>Exportar
                    </button>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Novo Produto
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Estatísticas Rápidas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card bg-primary bg-opacity-10 border-primary">
                <div class="card-body text-center">
                    <i class="bi bi-box-seam text-primary" style="font-size: 2rem;"></i>
                    <h4 class="text-primary mt-2 mb-1">@Model.Count()</h4>
                    <small class="text-muted">Total de Produtos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card bg-success bg-opacity-10 border-success">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    <h4 class="text-success mt-2 mb-1">@Model.Count(p => p.QuantidadeEstoque > 10)</h4>
                    <small class="text-muted">Em Estoque</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card bg-warning bg-opacity-10 border-warning">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 2rem;"></i>
                    <h4 class="text-warning mt-2 mb-1">@Model.Count(p => p.QuantidadeEstoque <= 10 && p.QuantidadeEstoque > 0)</h4>
                    <small class="text-muted">Baixo Estoque</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card bg-danger bg-opacity-10 border-danger">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle text-danger" style="font-size: 2rem;"></i>
                    <h4 class="text-danger mt-2 mb-1">@Model.Count(p => p.QuantidadeEstoque == 0)</h4>
                    <small class="text-muted">Sem Estoque</small>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-box text-muted" style="font-size: 4rem;"></i>
                        <h4 class="text-muted mt-3">Nenhum produto cadastrado</h4>
                        <p class="text-muted mb-4">Comece cadastrando seu primeiro produto para gerenciar seu estoque</p>
                        <a asp-action="Create" class="btn btn-primary btn-lg">
                            <i class="bi bi-plus-circle me-2"></i>Cadastrar Primeiro Produto
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Filtros e Busca -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar produtos...">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <select id="categoriaFilter" class="form-select">
                                    <option value="">Todas as Categorias</option>
                                    @foreach (var categoria in Model.Select(p => p.Categoria?.Nome).Distinct().Where(n => !string.IsNullOrEmpty(n)).OrderBy(n => n))
                                    {
                                        <option value="@categoria">@categoria</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select id="estoqueFilter" class="form-select">
                                    <option value="">Todos os Status</option>
                                    <option value="em-estoque">Em Estoque</option>
                                    <option value="baixo-estoque">Baixo Estoque</option>
                                    <option value="sem-estoque">Sem Estoque</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-outline-secondary w-100" onclick="limparFiltros()">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Limpar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lista de Produtos em Cards -->
        <div class="row g-4" id="produtosContainer">
            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 produto-card" 
                     data-nome="@item.Nome.ToLower()" 
                     data-categoria="@(item.Categoria?.Nome?.ToLower() ?? "")"
                     data-estoque="@item.QuantidadeEstoque"
                     data-preco="@item.Preco">
                    <div class="card h-100 produto-item">
                        <div class="card-header bg-transparent border-0 pb-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="bg-primary bg-opacity-10 p-2 rounded">
                                    <i class="bi bi-box text-primary"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.ProdutoId">
                                            <i class="bi bi-eye me-2"></i>Ver Detalhes
                                        </a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.ProdutoId">
                                            <i class="bi bi-pencil me-2"></i>Editar
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="confirmarExclusao(@item.ProdutoId, '@item.Nome')">
                                            <i class="bi bi-trash me-2"></i>Excluir
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-body text-center">
                            <h5 class="card-title mb-2">@item.Nome</h5>
                            <p class="card-text text-muted small mb-3">
                                @(string.IsNullOrEmpty(item.Descricao) ? "Sem descrição" : 
                                  item.Descricao.Length > 50 ? item.Descricao.Substring(0, 50) + "..." : item.Descricao)
                            </p>
                            
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Preço</small>
                                    <strong class="text-primary">@item.Preco.ToString("C")</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Estoque</small>
                                    <strong class="@(item.QuantidadeEstoque > 10 ? "text-success" : item.QuantidadeEstoque > 0 ? "text-warning" : "text-danger")">
                                        @item.QuantidadeEstoque
                                    </strong>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                @if (item.Categoria != null)
                                {
                                    <span class="badge bg-primary me-1">@item.Categoria.Nome</span>
                                }
                                @if (item.Fornecedor != null)
                                {
                                    <span class="badge bg-info">@item.Fornecedor.Nome</span>
                                }
                            </div>
                            
                            <div class="progress mb-3" style="height: 6px;">
                                @{
                                    var percentualEstoque = item.QuantidadeEstoque > 0 ? Math.Min(100, (item.QuantidadeEstoque / 100.0) * 100) : 0;
                                    var corEstoque = item.QuantidadeEstoque > 10 ? "bg-success" : item.QuantidadeEstoque > 0 ? "bg-warning" : "bg-danger";
                                }
                                <div class="progress-bar @corEstoque" style="width: @percentualEstoque%"></div>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <a asp-action="Edit" asp-route-id="@item.ProdutoId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Paginação -->
        <div class="row mt-4">
            <div class="col-12">
                <nav aria-label="Navegação de produtos">
                    <ul class="pagination justify-content-center">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">Anterior</a>
                        </li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                            <a class="page-link" href="#">Próximo</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    }
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="confirmacaoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir o produto <strong id="nomeProduto"></strong>?</p>
                <p class="text-muted small">Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarExclusao">
                    <i class="bi bi-trash me-2"></i>Excluir
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let produtoParaExcluir = null;

        // Função de busca e filtros
        document.getElementById('searchInput').addEventListener('input', filtrarProdutos);
        document.getElementById('categoriaFilter').addEventListener('change', filtrarProdutos);
        document.getElementById('estoqueFilter').addEventListener('change', filtrarProdutos);

        function filtrarProdutos() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const categoria = document.getElementById('categoriaFilter').value.toLowerCase();
            const estoque = document.getElementById('estoqueFilter').value;
            
            const produtos = document.querySelectorAll('.produto-card');
            let produtosVisiveis = 0;
            
            produtos.forEach(produto => {
                const nome = produto.dataset.nome;
                const cat = produto.dataset.categoria;
                const est = parseInt(produto.dataset.estoque);
                
                let mostrar = true;
                
                // Filtro de busca
                if (searchTerm && !nome.includes(searchTerm)) {
                    mostrar = false;
                }
                
                // Filtro de categoria
                if (categoria && cat !== categoria) {
                    mostrar = false;
                }
                
                // Filtro de estoque
                if (estoque) {
                    switch (estoque) {
                        case 'em-estoque':
                            if (est <= 10) mostrar = false;
                            break;
                        case 'baixo-estoque':
                            if (est > 10 || est === 0) mostrar = false;
                            break;
                        case 'sem-estoque':
                            if (est > 0) mostrar = false;
                            break;
                    }
                }
                
                if (mostrar) {
                    produto.style.display = 'block';
                    produtosVisiveis++;
                } else {
                    produto.style.display = 'none';
                }
            });

            // Mostrar mensagem se não houver resultados
            const mensagemSemResultados = document.getElementById('mensagemSemResultados');
            if (produtosVisiveis === 0) {
                if (!mensagemSemResultados) {
                    const mensagem = document.createElement('div');
                    mensagem.id = 'mensagemSemResultados';
                    mensagem.className = 'col-12';
                    mensagem.innerHTML = `
                        <div class="card text-center py-5">
                            <div class="card-body">
                                <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
                                <h4 class="text-muted mt-3">Nenhum produto encontrado</h4>
                                <p class="text-muted mb-4">Tente ajustar os filtros de busca</p>
                                <button class="btn btn-outline-primary" onclick="limparFiltros()">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Limpar Filtros
                                </button>
                            </div>
                        </div>
                    `;
                    document.getElementById('produtosContainer').appendChild(mensagem);
                }
            } else if (mensagemSemResultados) {
                mensagemSemResultados.remove();
            }
        }

        function limparFiltros() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categoriaFilter').value = '';
            document.getElementById('estoqueFilter').value = '';
            filtrarProdutos();
        }

        function exportarProdutos() {
            const produtos = Array.from(document.querySelectorAll('.produto-card:not([style*="display: none"])'));
            const dados = produtos.map(produto => ({
                nome: produto.querySelector('.card-title').textContent,
                categoria: produto.querySelector('.badge.bg-primary')?.textContent || 'Sem categoria',
                estoque: produto.dataset.estoque,
                preco: produto.dataset.preco
            }));

            const csv = [
                ['Nome', 'Categoria', 'Estoque', 'Preço'],
                ...dados.map(p => [p.nome, p.categoria, p.estoque, p.preco])
            ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', 'produtos.csv');
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            // Mostrar notificação de sucesso
            if (typeof showSuccess === 'function') {
                showSuccess('Produtos exportados com sucesso!');
            }
        }

        function confirmarExclusao(produtoId, nomeProduto) {
            produtoParaExcluir = produtoId;
            document.getElementById('nomeProduto').textContent = nomeProduto;
            const modal = new bootstrap.Modal(document.getElementById('confirmacaoModal'));
            modal.show();
        }

        // Confirmar exclusão
        document.getElementById('btnConfirmarExclusao').addEventListener('click', function() {
            if (produtoParaExcluir) {
                window.location.href = `/Produtos/Delete/${produtoParaExcluir}`;
            }
        });

        // Adicionar animações aos cards
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.produto-card');
            cards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
                card.classList.add('animate-fade-in-up');
            });

            // Adicionar tooltips aos botões
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // Adicionar funcionalidade de ordenação
        function ordenarProdutos(criterio) {
            const container = document.getElementById('produtosContainer');
            const produtos = Array.from(container.children);
            
            produtos.sort((a, b) => {
                let valorA, valorB;
                
                switch (criterio) {
                    case 'nome':
                        valorA = a.querySelector('.card-title').textContent.toLowerCase();
                        valorB = b.querySelector('.card-title').textContent.toLowerCase();
                        return valorA.localeCompare(valorB);
                    case 'preco':
                        valorA = parseFloat(a.dataset.preco);
                        valorB = parseFloat(b.dataset.preco);
                        return valorA - valorB;
                    case 'estoque':
                        valorA = parseInt(a.dataset.estoque);
                        valorB = parseInt(b.dataset.estoque);
                        return valorA - valorB;
                    default:
                        return 0;
                }
            });
            
            produtos.forEach(produto => container.appendChild(produto));
        }
    </script>
}
