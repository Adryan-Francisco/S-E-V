@model IEnumerable<SEV.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="container-fluid">
    <!-- Header da Página -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="text-gradient mb-2">
                        <i class="bi bi-tags me-3"></i>Categorias
                    </h1>
                    <p class="text-muted mb-0">Organize seus produtos em categorias para melhor gestão</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-info" onclick="exportarCategorias()" title="Exportar para Excel">
                        <i class="bi bi-file-earmark-excel me-2"></i>Exportar
                    </button>
                    <button class="btn btn-outline-warning" onclick="mostrarRelatorioCategorias()" title="Relatório de Categorias">
                        <i class="bi bi-graph-up me-2"></i>Relatório
                    </button>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>Nova Categoria
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Estatísticas Rápidas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card bg-primary bg-opacity-10 border-primary">
                <div class="card-body text-center">
                    <i class="bi bi-tags text-primary stats-icon"></i>
                    <h4 class="text-primary mt-2 mb-1 fw-bold">@Model.Count()</h4>
                    <small class="text-muted">Total de Categorias</small>
                    <div class="mt-2">
                        <span class="badge bg-primary">@Model.Count(c => (c.Produtos?.Count ?? 0) > 0) ativas</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card bg-success bg-opacity-10 border-success">
                <div class="card-body text-center">
                    <i class="bi bi-box text-success stats-icon"></i>
                    <h4 class="text-success mt-2 mb-1 fw-bold">@Model.Sum(c => c.Produtos?.Count ?? 0)</h4>
                    <small class="text-muted">Total de Produtos</small>
                    <div class="mt-2">
                        <span class="badge bg-success">@Model.Count(c => (c.Produtos?.Count ?? 0) > 0) categorias ativas</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card bg-info bg-opacity-10 border-info">
                <div class="card-body text-center">
                    <i class="bi bi-star text-info stats-icon"></i>
                    <h4 class="text-info mt-2 mb-1 fw-bold">@(Model.Max(c => c.Produtos?.Count ?? 0))</h4>
                    <small class="text-muted">Maior Categoria</small>
                    <div class="mt-2">
                        <span class="badge bg-info">@Model.OrderByDescending(c => c.Produtos?.Count ?? 0).FirstOrDefault()?.Nome</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card stats-card bg-warning bg-opacity-10 border-warning">
                <div class="card-body text-center">
                    <i class="bi bi-exclamation-triangle text-warning stats-icon"></i>
                    <h4 class="text-warning mt-2 mb-1 fw-bold">@Model.Count(c => (c.Produtos?.Count ?? 0) == 0)</h4>
                    <small class="text-muted">Sem Produtos</small>
                    <div class="mt-2">
                        <span class="badge bg-warning">Precisam de atenção</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card text-center py-5 border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-tags text-muted empty-state-icon"></i>
                        <h4 class="text-muted mt-3">Nenhuma categoria criada</h4>
                        <p class="text-muted mb-4">Comece criando suas primeiras categorias para organizar os produtos</p>
                        <a asp-action="Create" class="btn btn-primary btn-lg">
                            <i class="bi bi-plus-circle me-2"></i>Criar Primeira Categoria
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Filtros e Busca -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0">
                        <h5 class="mb-0">
                            <i class="bi bi-funnel me-2 text-primary"></i>Filtros e Busca
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="bi bi-search"></i>
                                    </span>
                                    <input type="text" id="searchInput" class="form-control" placeholder="Buscar categorias...">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <select id="produtosFilter" class="form-select">
                                    <option value="">Todas as Categorias</option>
                                    <option value="com-produtos">Com Produtos</option>
                                    <option value="sem-produtos">Sem Produtos</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-outline-secondary w-100" onclick="limparFiltros()">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Limpar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid de Categorias -->
        <div class="row g-4" id="categoriasContainer">
            @foreach (var categoria in Model.OrderBy(c => c.Nome))
            {
                <div class="col-xl-3 col-lg-4 col-md-6 categoria-card" 
                     data-nome="@categoria.Nome.ToLower()" 
                     data-produtos="@(categoria.Produtos?.Count ?? 0)">
                    <div class="card h-100 categoria-item border-0 shadow-sm">
                        <div class="card-header bg-transparent border-0 pb-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="categoria-icon bg-primary bg-opacity-10 p-3 rounded">
                                    <i class="bi bi-tag text-primary fs-4"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@categoria.CategoriaId">
                                            <i class="bi bi-eye me-2"></i>Ver Detalhes
                                        </a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@categoria.CategoriaId">
                                            <i class="bi bi-pencil me-2"></i>Editar
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="confirmarExclusao(@categoria.CategoriaId, '@categoria.Nome')">
                                            <i class="bi bi-trash me-2"></i>Excluir
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-body text-center">
                            <h5 class="card-title mb-2">@categoria.Nome</h5>
                            <p class="card-text text-muted small mb-3">
                                @(categoria.Produtos?.Count ?? 0) produto(s) cadastrado(s)
                            </p>
                            
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Produtos</small>
                                    <strong class="@((categoria.Produtos?.Count ?? 0) > 0 ? "text-success" : "text-warning")">
                                        @(categoria.Produtos?.Count ?? 0)
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">ID</small>
                                    <strong class="text-primary">@categoria.CategoriaId</strong>
                                </div>
                            </div>
                            
                            @if ((categoria.Produtos?.Count ?? 0) > 0)
                            {
                                <div class="progress mb-3" style="height: 6px;">
                                    @{
                                        var percentual = Math.Min(100, ((categoria.Produtos?.Count ?? 0) / (double)Model.Max(c => c.Produtos?.Count ?? 1)) * 100);
                                        var cor = (categoria.Produtos?.Count ?? 0) > 5 ? "bg-success" : (categoria.Produtos?.Count ?? 0) > 0 ? "bg-warning" : "bg-danger";
                                    }
                                    <div class="progress-bar @cor" style="width: @percentual%"></div>
                                </div>
                            }
                            
                            <div class="d-grid gap-2">
                                <a asp-action="Edit" asp-route-id="@categoria.CategoriaId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="confirmacaoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Exclusão
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Tem certeza que deseja excluir a categoria <strong id="nomeCategoria"></strong>?</p>
                <p class="text-muted small">Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarExclusao">
                    <i class="bi bi-trash me-2"></i>Excluir
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Relatório de Categorias -->
<div class="modal fade" id="relatorioCategoriasModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-graph-up me-2 text-primary"></i>Relatório de Categorias
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h6 class="text-primary">Distribuição de Produtos</h6>
                                <div id="produtosChartContainer" style="height: 200px;">
                                    <canvas id="produtosChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h6 class="text-primary">Status das Categorias</h6>
                                <div id="statusChartContainer" style="height: 200px;">
                                    <canvas id="statusChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <h6>Ranking das Categorias:</h6>
                    <div class="list-group">
                        @foreach (var categoria in Model.OrderByDescending(c => c.Produtos?.Count ?? 0))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@categoria.Nome</strong>
                                    <br>
                                    <small class="text-muted">@(categoria.Produtos?.Count ?? 0) produto(s)</small>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-@((categoria.Produtos?.Count ?? 0) > 0 ? "success" : "warning")">
                                        @(categoria.Produtos?.Count ?? 0) produto(s)
                                    </span>
                                    <br>
                                    <small class="text-muted">ID: @categoria.CategoriaId</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <button type="button" class="btn btn-primary" onclick="exportarRelatorio()">
                    <i class="bi bi-download me-2"></i>Exportar Relatório
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let categoriaParaExcluir = null;

        // Função de busca e filtros
        function filtrarCategorias() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const produtosFilter = document.getElementById('produtosFilter').value;
            
            const categorias = document.querySelectorAll('.categoria-card');
            let categoriasVisiveis = 0;
            
            categorias.forEach(categoria => {
                const nome = categoria.dataset.nome;
                const produtos = parseInt(categoria.dataset.produtos);
                
                let mostrar = true;
                
                // Filtro de busca
                if (searchTerm && !nome.includes(searchTerm)) {
                    mostrar = false;
                }
                
                // Filtro de produtos
                if (produtosFilter) {
                    switch (produtosFilter) {
                        case 'com-produtos':
                            if (produtos === 0) mostrar = false;
                            break;
                        case 'sem-produtos':
                            if (produtos > 0) mostrar = false;
                            break;
                    }
                }
                
                if (mostrar) {
                    categoria.style.display = 'block';
                    categoriasVisiveis++;
                } else {
                    categoria.style.display = 'none';
                }
            });

            // Mostrar mensagem se não houver resultados
            const mensagemSemResultados = document.getElementById('mensagemSemResultados');
            if (categoriasVisiveis === 0) {
                if (!mensagemSemResultados) {
                    const mensagem = document.createElement('div');
                    mensagem.id = 'mensagemSemResultados';
                    mensagem.className = 'col-12';
                    mensagem.innerHTML = `
                        <div class="card text-center py-5">
                            <div class="card-body">
                                <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
                                <h4 class="text-muted mt-3">Nenhuma categoria encontrada</h4>
                                <p class="text-muted mb-4">Tente ajustar os filtros de busca</p>
                                <button class="btn btn-outline-primary" onclick="limparFiltros()">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Limpar Filtros
                                </button>
                            </div>
                        </div>
                    `;
                    document.getElementById('categoriasContainer').appendChild(mensagem);
                }
            } else if (mensagemSemResultados) {
                mensagemSemResultados.remove();
            }
        }

        // Limpar filtros
        function limparFiltros() {
            document.getElementById('searchInput').value = '';
            document.getElementById('produtosFilter').value = '';
            filtrarCategorias();
        }

        // Exportar categorias
        function exportarCategorias() {
            const categorias = Array.from(document.querySelectorAll('.categoria-card:not([style*="display: none"])'));
                            const dados = categorias.map(categoria => ({
                    nome: categoria.querySelector('.card-title').textContent,
                    produtos: categoria.querySelector('.card-text').textContent,
                    quantidade: categoria.dataset.produtos,
                    id: categoria.querySelector('.text-primary').textContent
                }));

            const csv = [
                ['Nome', 'Produtos', 'Quantidade', 'ID'],
                ...dados.map(c => [c.nome, c.produtos, c.quantidade, c.id])
            ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'categorias.csv';
            link.click();
        }

        // Mostrar relatório de categorias
        function mostrarRelatorioCategorias() {
            const modal = new bootstrap.Modal(document.getElementById('relatorioCategoriasModal'));
            modal.show();
            
            // Criar gráficos
            setTimeout(() => {
                // Gráfico de produtos por categoria
                const produtosCtx = document.getElementById('produtosChart').getContext('2d');
                const categorias = @Html.Raw(Json.Serialize(Model.Select(c => new { Nome = c.Nome, Produtos = c.Produtos?.Count ?? 0 })));
                
                new Chart(produtosCtx, {
                    type: 'bar',
                    data: {
                        labels: categorias.map(c => c.Nome),
                        datasets: [{
                            label: 'Quantidade de Produtos',
                            data: categorias.map(c => c.Produtos),
                            backgroundColor: 'rgba(37, 99, 235, 0.8)',
                            borderColor: '#2563eb',
                            borderWidth: 2,
                            borderRadius: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: 'rgba(0, 0, 0, 0.1)' }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
                
                // Gráfico de status
                const statusCtx = document.getElementById('statusChart').getContext('2d');
                const totalCategorias = @Model.Count();
                const comProdutos = @Model.Count(c => (c.Produtos?.Count ?? 0) > 0);
                const semProdutos = @Model.Count(c => (c.Produtos?.Count ?? 0) == 0);
                
                new Chart(statusCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Com Produtos', 'Sem Produtos'],
                        datasets: [{
                            data: [comProdutos, semProdutos],
                            backgroundColor: ['#10b981', '#f59e0b']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }, 100);
        }

        // Exportar relatório
        function exportarRelatorio() {
            const relatorio = {
                data: new Date().toLocaleDateString('pt-BR'),
                totalCategorias: @Model.Count(),
                totalProdutos: @Model.Sum(c => c.Produtos?.Count ?? 0),
                categoriasComProdutos: @Model.Count(c => (c.Produtos?.Count ?? 0) > 0),
                categoriasSemProdutos: @Model.Count(c => (c.Produtos?.Count ?? 0) == 0),
                maiorCategoria: @Html.Raw(Json.Serialize(Model.OrderByDescending(c => c.Produtos?.Count ?? 0).FirstOrDefault()?.Nome))
            };
            
            const blob = new Blob([JSON.stringify(relatorio, null, 2)], { type: 'application/json' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'relatorio-categorias.json';
            link.click();
        }

        function confirmarExclusao(categoriaId, nomeCategoria) {
            categoriaParaExcluir = categoriaId;
            document.getElementById('nomeCategoria').textContent = nomeCategoria;
            const modal = new bootstrap.Modal(document.getElementById('confirmacaoModal'));
            modal.show();
        }

        // Confirmar exclusão
        document.getElementById('btnConfirmarExclusao').addEventListener('click', function() {
            if (categoriaParaExcluir) {
                window.location.href = `/Categorias/Delete/${categoriaParaExcluir}`;
            }
        });

        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('searchInput').addEventListener('input', filtrarCategorias);
            document.getElementById('produtosFilter').addEventListener('change', filtrarCategorias);
        });
    </script>
}

<style>
    .text-gradient {
        background: linear-gradient(45deg, #2563eb, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .stats-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.1);
    }
    
    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }
    
    .stats-icon {
        font-size: 2.5rem;
        transition: all 0.3s ease;
    }
    
    .stats-card:hover .stats-icon {
        transform: scale(1.1);
    }
    
    .categoria-item {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.1);
    }
    
    .categoria-item:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }
    
    .categoria-icon {
        transition: all 0.3s ease;
    }
    
    .categoria-item:hover .categoria-icon {
        transform: scale(1.1);
    }
    
    .empty-state-icon {
        font-size: 4rem;
        opacity: 0.5;
    }
    
    .progress {
        border-radius: 10px;
    }
    
    .progress-bar {
        border-radius: 10px;
    }
    
    @@media print {
        .btn, .btn-group, .dropdown {
            display: none !important;
        }
        
        .card {
            border: 1px solid #000 !important;
            box-shadow: none !important;
        }
    }
</style>
