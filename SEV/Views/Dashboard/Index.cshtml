@model SEV.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Header do Dashboard -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-gradient mb-2">
                <i class="bi bi-speedometer2 text-primary me-3"></i>Dashboard
            </h1>
            <p class="text-muted mb-0">Visão geral completa do sistema de vendas SEV</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>Imprimir
            </button>
            <button class="btn btn-primary" id="refreshDashboardBtn" onclick="refreshDashboard()">
                <i class="bi bi-arrow-clockwise me-2"></i>Atualizar
            </button>
        </div>
    </div>

    <!-- Alertas e Notificações -->
    @if (Model.Alertas?.Any() == true)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-bell me-3 fs-4"></i>
                        <div class="flex-grow-1">
                            <h6 class="alert-heading mb-1">Notificações e Alertas</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var alerta in Model.Alertas)
                                {
                                    <a href="@alerta.Url" class="btn btn-sm btn-outline-@alerta.Cor">
                                        <i class="bi @alerta.Icone me-1"></i>@alerta.Mensagem
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Cards de Estatísticas Principais -->
    <div class="row g-4 mb-5">
        <div class="col-xl-3 col-md-6">
            <div class="card stats-card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="stats-icon bg-primary bg-opacity-10 text-primary mx-auto mb-3">
                        <i class="bi bi-box fs-1"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalProdutos.ToString("N0")</h3>
                    <p class="text-muted mb-2">Total de Produtos</p>
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <span class="badge bg-success">@Model.CategoriasAtivas categorias</span>
                        <span class="badge bg-warning">@Model.ProdutosBaixoEstoque baixo estoque</span>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="card stats-card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="stats-icon bg-success bg-opacity-10 text-success mx-auto mb-3">
                        <i class="bi bi-cash-coin fs-1"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.TotalVendas.ToString("N0")</h3>
                    <p class="text-muted mb-2">Total de Vendas</p>
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <span class="badge bg-success">@Model.VendasMesAtual este mês</span>
                        @if (Model.CrescimentoVendas > 0)
                        {
                            <span class="badge bg-success">+@Model.CrescimentoVendas.ToString("F1")%</span>
                        }
                        else if (Model.CrescimentoVendas < 0)
                        {
                            <span class="badge bg-danger">@Model.CrescimentoVendas.ToString("F1")%</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="card stats-card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="stats-icon bg-warning bg-opacity-10 text-warning mx-auto mb-3">
                        <i class="bi bi-currency-dollar fs-1"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">R$ @Model.FaturamentoTotal.ToString("N2")</h3>
                    <p class="text-muted mb-2">Faturamento Total</p>
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <span class="badge bg-info">R$ @Model.FaturamentoMesAtual.ToString("N2") este mês</span>
                        @if (Model.CrescimentoFaturamento > 0)
                        {
                            <span class="badge bg-success">+@Model.CrescimentoFaturamento.ToString("F1")%</span>
                        }
                        else if (Model.CrescimentoFaturamento < 0)
                        {
                            <span class="badge bg-danger">@Model.CrescimentoFaturamento.ToString("F1")%</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6">
            <div class="card stats-card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="stats-icon bg-info bg-opacity-10 text-info mx-auto mb-3">
                        <i class="bi bi-people fs-1"></i>
                    </div>
                    <h3 class="mb-1 fw-bold">@Model.ClientesAtivos.ToString("N0")</h3>
                    <p class="text-muted mb-2">Clientes Ativos</p>
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <span class="badge bg-primary">@Model.FornecedoresAtivos fornecedores</span>
                        <span class="badge bg-secondary">R$ @Model.TicketMedio.ToString("N2") ticket médio</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos Principais -->
    <div class="row g-4 mb-5">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-graph-up me-2 text-primary"></i>Vendas por Mês
                    </h5>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="vendasMesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2 text-warning"></i>Produtos com Baixo Estoque
                    </h5>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="baixoEstoqueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos Secundários -->
    <div class="row g-4 mb-5">
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-star me-2 text-success"></i>Top Produtos por Vendas
                    </h5>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 300px;">
                        <canvas id="topProdutosChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-tags me-2 text-info"></i>Produtos por Categoria
                    </h5>
                </div>
                <div class="card-body">
                    <div class="chart-container" style="height: 300px;">
                        <canvas id="categoriasChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabelas de Dados Recentes -->
    <div class="row g-4 mb-5">
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-box me-2 text-primary"></i>Produtos Recentes
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.ProdutosRecentes?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var produto in Model.ProdutosRecentes)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@produto.Nome</h6>
                                        <small class="text-muted">R$ @produto.Preco.ToString("N2")</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@(produto.QuantidadeEstoque > 10 ? "success" : produto.QuantidadeEstoque > 0 ? "warning" : "danger")">
                                            @produto.QuantidadeEstoque
                                        </span>
                                        <br>
                                        <small class="text-muted">@(produto.Categoria?.Nome ?? "Sem categoria")</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-inbox text-muted fs-1"></i>
                            <p class="text-muted mt-2">Nenhum produto cadastrado</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-cash-coin me-2 text-success"></i>Vendas Recentes
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.VendasRecentes?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var venda in Model.VendasRecentes)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">Venda #@venda.VendaId</h6>
                                        <small class="text-muted">@venda.DataVenda.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-success">R$ @venda.TotalCalculado.ToString("N2")</span>
                                        <br>
                                        <small class="text-muted">@(venda.Itens?.Count ?? 0) itens</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-inbox text-muted fs-1"></i>
                            <p class="text-muted mt-2">Nenhuma venda realizada</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-people me-2 text-info"></i>Clientes Recentes
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.ClientesRecentes?.Any() == true)
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var cliente in Model.ClientesRecentes)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@cliente.Nome</h6>
                                        <small class="text-muted">@cliente.Telefone</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-primary">@cliente.Telefone</span>
                                        <br>
                                        <small class="text-muted">@cliente.Endereco</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-inbox text-muted fs-1"></i>
                            <p class="text-muted mt-2">Nenhum cliente cadastrado</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Atividades Recentes -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-activity me-2 text-primary"></i>Atividades Recentes
                    </h5>
                    <button class="btn btn-sm btn-outline-primary" id="refreshAtividadesBtn" onclick="refreshAtividades()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Atualizar
                    </button>
                </div>
                <div class="card-body">
                    @if (Model.AtividadesRecentes?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Descrição</th>
                                        <th>Usuário</th>
                                        <th>Data/Hora</th>
                                        <th>Status</th>
                                        <th>Valor</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var atividade in Model.AtividadesRecentes)
                                    {
                                        <tr class="atividade-row" data-tipo="@atividade.Tipo" data-id="@atividade.Id">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi @atividade.Icone me-2 text-primary"></i>
                                                    <span class="badge bg-light text-dark">@atividade.Tipo</span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="fw-medium">@atividade.Descricao</div>
                                            </td>
                                            <td>
                                                <span class="text-muted">@atividade.Usuario</span>
                                            </td>
                                            <td>
                                                <span class="text-muted">@atividade.DataHora.ToString("dd/MM/yyyy HH:mm")</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@atividade.CorStatus">@atividade.Status</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@atividade.Valor</small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-primary btn-sm btn-detalhes-atividade" 
                                                            data-tipo="@atividade.Tipo" 
                                                            data-id="@atividade.Id"
                                                            title="Ver Detalhes">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    @if (atividade.Tipo == "Produto")
                                                    {
                                                        <a href="@Url.Action("Edit", "Produtos", new { id = atividade.Id })" 
                                                           class="btn btn-outline-warning btn-sm" 
                                                           title="Editar">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    }
                                                    else if (atividade.Tipo == "Cliente")
                                                    {
                                                        <a href="@Url.Action("Edit", "Clientes", new { id = atividade.Id })" 
                                                           class="btn btn-outline-warning btn-sm" 
                                                           title="Editar">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                    }
                                                    else if (atividade.Tipo == "Venda")
                                                    {
                                                        <a href="@Url.Action("Details", "VendasCompletas", new { id = atividade.Id })" 
                                                           class="btn btn-outline-info btn-sm" 
                                                           title="Ver Venda">
                                                            <i class="bi bi-receipt"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-inbox display-4 text-muted"></i>
                            <h5 class="text-muted mt-3">Nenhuma atividade recente</h5>
                            <p class="text-muted">As atividades aparecerão aqui conforme o sistema for utilizado.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Gráfico de Vendas por Mês
        const vendasMesCtx = document.getElementById('vendasMesChart').getContext('2d');
        const vendasMesChart = new Chart(vendasMesCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.Meses ?? new List<string>())),
                datasets: [{
                    label: 'Faturamento (R$)',
                    data: @Html.Raw(Json.Serialize(Model.VendasPorMes ?? new List<decimal>())),
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37, 99, 235, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#2563eb',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 6,
                    yAxisID: 'y'
                }, {
                    label: 'Quantidade de Vendas',
                    data: @Html.Raw(Json.Serialize(Model.QuantidadeVendasPorMes ?? new List<int>())),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 3,
                    fill: false,
                    tension: 0.4,
                    pointBackgroundColor: '#10b981',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 6,
                    yAxisID: 'y1'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#2563eb',
                        borderWidth: 1,
                        cornerRadius: 8
                    }
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(0, 0, 0, 0.1)'
                        },
                        ticks: {
                            callback: function(value) {
                                return 'R$ ' + value.toLocaleString('pt-BR');
                            }
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        beginAtZero: true,
                        grid: {
                            drawOnChartArea: false,
                        },
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('pt-BR');
                            }
                        }
                    },
                    x: {
                        grid: {
                            color: 'rgba(0, 0, 0, 0.1)'
                        }
                    }
                }
            }
        });

        // Gráfico de Produtos com Baixo Estoque
        const baixoEstoqueCtx = document.getElementById('baixoEstoqueChart').getContext('2d');
        const baixoEstoqueChart = new Chart(baixoEstoqueCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ProdutosBaixoEstoqueNomes ?? new List<string>())),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.ProdutosBaixoEstoqueQtd ?? new List<int>())),
                    backgroundColor: [
                        '#ef4444', '#f59e0b', '#10b981', '#3b82f6',
                        '#8b5cf6', '#ec4899', '#06b6d4', '#84cc16'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            font: { size: 12 }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#2563eb',
                        borderWidth: 1,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + context.parsed + ' unidades';
                            }
                        }
                    }
                }
            }
        });

        // Gráfico de Top Produtos
        const topProdutosCtx = document.getElementById('topProdutosChart').getContext('2d');
        const topProdutosChart = new Chart(topProdutosCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TopProdutosNomes ?? new List<string>())),
                datasets: [{
                    label: 'Quantidade Vendida',
                    data: @Html.Raw(Json.Serialize(Model.TopProdutosVendas ?? new List<int>())),
                    backgroundColor: 'rgba(16, 185, 129, 0.8)',
                    borderColor: '#10b981',
                    borderWidth: 2,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#10b981',
                        borderWidth: 1,
                        cornerRadius: 8
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0, 0, 0, 0.1)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Gráfico de Categorias
        const categoriasCtx = document.getElementById('categoriasChart').getContext('2d');
        const categoriasChart = new Chart(categoriasCtx, {
            type: 'pie',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.CategoriasNomes ?? new List<string>())),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.CategoriasQuantidade ?? new List<int>())),
                    backgroundColor: [
                        '#3b82f6', '#8b5cf6', '#ec4899', '#06b6d4',
                        '#84cc16', '#f59e0b', '#ef4444', '#10b981'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            usePointStyle: true,
                            font: { size: 12 }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#ffffff',
                        bodyColor: '#ffffff',
                        borderColor: '#3b82f6',
                        borderWidth: 1,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + context.parsed + ' produtos';
                            }
                        }
                    }
                }
            }
        });

        // Função para atualizar o dashboard
        function refreshDashboard() {
            const btn = document.getElementById('refreshDashboardBtn');
            const icon = btn.querySelector('i');
            
            btn.disabled = true;
            icon.className = 'bi bi-arrow-clockwise me-2 spin';
            
            setTimeout(() => {
                location.reload();
            }, 1000);
        }

        // Função para atualizar atividades
        function refreshAtividades() {
            const btn = document.getElementById('refreshAtividadesBtn');
            const icon = btn.querySelector('i');
            
            btn.disabled = true;
            icon.className = 'bi bi-arrow-clockwise me-1 spin';
            
            const atividadeRows = document.querySelectorAll('.atividade-row');
            atividadeRows.forEach(row => {
                row.style.opacity = '0.5';
                row.style.transition = 'opacity 0.3s ease';
            });
            
            setTimeout(() => {
                location.reload();
            }, 1000);
        }

        // Função para ver detalhes da atividade
        function verDetalhesAtividade(tipo, id) {
            let url = '';
            
            switch(tipo) {
                case 'Produto':
                    url = `/Produtos/Details/${id}`;
                    break;
                case 'Cliente':
                    url = `/Clientes/Details/${id}`;
                    break;
                case 'Venda':
                    url = `/VendasCompletas/Details/${id}`;
                    break;
                case 'Categoria':
                    url = `/Categorias/Details/${id}`;
                    break;
                default:
                    console.log('Tipo de atividade não reconhecido:', tipo);
                    return;
            }
            
            if (url) {
                window.open(url, '_blank');
            }
        }

        // Adicionar animações aos cards quando a página carregar
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                setTimeout(() => {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    card.style.transition = 'all 0.6s ease';
                    
                    setTimeout(() => {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    }, 100);
                }, index * 100);
            });
        });

        // Adicionar evento de clique para botões de detalhes
        document.addEventListener('click', function(e) {
            if (e.target.closest('.btn-detalhes-atividade')) {
                const btn = e.target.closest('.btn-detalhes-atividade');
                const tipo = btn.dataset.tipo;
                const id = btn.dataset.id;
                verDetalhesAtividade(tipo, id);
            }
        });
    </script>
}

